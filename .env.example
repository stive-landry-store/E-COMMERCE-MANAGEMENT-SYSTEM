VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Payunit — set these as Supabase Edge Function secrets (Dashboard → Edge Functions → Secrets)
# Do not put live keys in VITE_ variables (they would be public in the browser).
PAYUNIT_API_USER=
PAYUNIT_API_PASSWORD=
PAYUNIT_API_KEY=
PAYUNIT_MODE=test
PAYUNIT_BASE_URL=https://gateway.payunit.net
SITE_URL=https://stive-landry-store.vercel.app

# CamerPay (legacy — unused if Payunit is connected)
CAMERPAY_API_TOKEN=
CAMERPAY_WEBHOOK_SECRET=
CAMERPAY_BASE_URL=https://camerpay.biz/api
